# Server Configuration
PORT=3000

# SQLite Database
DB_DATABASE=database.sqlite
DB_LOGGING=false
DB_SYNCHRONIZE=false

# Internal Security
API_BEARER_TOKEN=your-secret-bearer-token-here

# Speech-to-Text via OpenRouter Whisper
WHISPER_URL=https://openrouter.ai/api/v1
WHISPER_MODEL=openai/whisper-large-v3

# Multimodal AI via OpenRouter Gemini
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Webhook Delivery (n8n Integration)
WEBHOOK_URL=https://n8n.your-domain.internal/webhook/video-summary
WEBHOOK_AUTH_HEADER=X-N8N-Webhook-Token
WEBHOOK_AUTH_TOKEN=your-webhook-auth-secret-here

# Worker & Scratchpad Configuration
TEMP_DIR=/tmp/video-analyzer
MAX_CONCURRENT_JOBS=3
